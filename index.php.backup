<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Anime Lokal Zidan</title>
    <style>
        body { font-family: sans-serif; background: #121212; color: #e0e0e0; margin: 0; padding: 20px; }
        h1 { color: #bb86fc; }
        h2 { color: #03dac6; border-bottom: 1px solid #333; padding-bottom: 5px; margin-top: 30px; }
        h3 { color: #cf6679; margin-bottom: 5px; }
        ul { list-style-type: none; padding-left: 0; }
        li { background: #1e1e1e; margin-bottom: 6px; padding: 10px 15px; border-radius: 6px; display: flex; justify-content: space-between; align-items: center; }
        a { color: #80d8ff; text-decoration: none; }
        a:hover { text-decoration: underline; }
        .size { color: #888; font-size: 0.85em; }
        .anime-box { background: #181818; padding: 15px; border-radius: 8px; margin-bottom: 15px; border: 1px solid #2a2a2a; }
    </style>
</head>
<body>
    <h1>Koleksi Anime Zidan</h1>
    
    <?php
    $baseDir = 'anime/'; // Mengarah ke symlink /srv/http/anime
    
    if (is_dir($baseDir)) {
        // Kategori utama yang dicari (end & ongoing)
        $categories = ['end', 'ongoing'];
        
        foreach ($categories as $cat) {
            $catPath = $baseDir . $cat;
            if (is_dir($catPath)) {
                echo "<h2>Kategori: " . strtoupper($cat) . "</h2>";
                
                // Pindai isi folder end/ atau ongoing/ (berisi judul-judul anime)
                $animeShows = scandir($catPath);
                foreach ($animeShows as $show) {
                    if ($show !== '.' && $show !== '..' && $show[0] !== '.') {
                        $showPath = $catPath . '/' . $show;
                        
                        if (is_dir($showPath)) {
                            echo "<div class=\"anime-box\">";
                            echo "<h3>📁 " . htmlspecialchars($show) . "</h3>";
                            echo "<ul>";
                            
                            // Pindai file episode di dalam folder anime tersebut
                            $episodes = scandir($showPath);
                            foreach ($episodes as $ep) {
                                if ($ep !== '.' && $ep !== '..' && $ep[0] !== '.') {
                                    $epPath = $showPath . '/' . $ep;
                                    
                                    // Pastikan itu adalah file (misal: mkv, mp4) bukan subfolder lagi
                                    if (is_file($epPath)) {
                                        $fileSize = round(filesize($epPath) / 1024 / 1024, 2) . ' MB';
                                        // Jalur relatif untuk URL web
                                        $webPath = 'anime/' . $cat . '/' . rawurlencode($show) . '/' . rawurlencode($ep);
                                        
                                        echo "<li>";
                                        echo "<a href=\"" . $webPath . "\" target=\"_blank\">🎬 " . htmlspecialchars($ep) . "</a>";
                                        echo "<span class=\"size\">{$fileSize}</span>";
                                        echo "</li>";
                                    }
                                }
                            }
                            echo "</ul>";
                            echo "</div>";
                        }
                    }
                }
            }
        }
    } else {
        echo "<p>Folder anime tidak ditemukan atau symlink belum terhubung.</p>";
    }
    ?>
</body>
</html>
